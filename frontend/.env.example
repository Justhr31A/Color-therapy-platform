# Copy to .env and adjust if your backend runs somewhere other than localhost:4000
VITE_API_URL=http://localhost:4000

# Optional — live camera AR (docs/CAMERA_AR.md). Leave unset to load MediaPipe's files from their public CDNs.
# Set only if you self-host them or a network blocks the CDN. The WASM folder MUST match @mediapipe/tasks-vision 0.10.14.
# VITE_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm
# VITE_HAND_LANDMARKER_MODEL=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task
