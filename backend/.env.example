# Copy this file to .env and fill in real values. Never commit .env.

# Port the API server listens on
PORT=4000

# Secret used to sign JWTs. MUST be a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# --- Database: PostgreSQL (required) --------------------------------------------------------------
# The backend refuses to start without it; there is no file-database fallback.
# Neon: copy the connection string from the Neon console (it includes ?sslmode=require, which also verifies the certificate).
# Prefer Neon's POOLED connection string (host contains "-pooler") for the web service.
DATABASE_URL=postgres://user:password@your-project-pooler.region.aws.neon.tech/dbname?sslmode=require
# Local development against a plain local server (no TLS):
# DATABASE_URL=postgres://postgres@127.0.0.1:5432/colour_therapy
# PGSSL=false
#
# Optional tuning (defaults shown):
# PGSSL=true                      # TLS on (ignored when the URL itself sets sslmode)
# PGSSL_REJECT_UNAUTHORIZED=true  # verify the server certificate
# PGPOOL_MAX=5                    # connections per server process (max 20)
# PG_CONNECT_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=30000
# DB_MIGRATE_ON_START=true        # false: refuse to start if migrations are pending (run `npm run db:migrate` instead)

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Set to "true" when serving the API over HTTPS in production
# (makes the auth cookie Secure + SameSite=None capable)
COOKIE_SECURE=false

# --- AI Protocol Assistant (Stage 1) --------------------------------------------------------------
# The assistant is switched on/off with the AI_ASSESSMENT feature flag (OFF by default), not with these.
# AI_PROVIDER chooses how requests are interpreted. Stages 1 and 2 ship only the development provider, which needs no key:
#   AI_PROVIDER=mock
# A real provider may arrive in a later stage and would read its key from AI_API_KEY (nothing reads it today). That key belongs ONLY in the
# backend's environment (for example Render's environment settings): it is never sent to the browser or logged.
# AI_API_KEY=

# --- Tests only ----------------------------------------------------------------------------------
# A DISPOSABLE PostgreSQL server the tests may create/drop ctpp_test_* databases on (never production):
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres

# --- One-off SQLite import only (npm run db:import-sqlite) ----------------------------------------
# SQLITE_SOURCE_FILE=./data/protocol_platform.db
